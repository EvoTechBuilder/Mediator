  <ItemGroup>
    <ProjectReference Include="..\EvoTechBuilder.Mediator\EvoTechBuilder.Mediator.csproj" />
    <ProjectReference Include="..\EvoTechBuilder.Mediator.Abstractions\EvoTechBuilder.Mediator.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
