<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>EvoTechBuilder.Mediator.DependencyInjection</PackageId>
    <Version>1.0.0</Version>
    <Authors>Evo Tech Builder</Authors>
    <Company>Evo Tech Builder</Company>
    <Description>Dependency injection integration for EvoTechBuilder.Mediator.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mediator;dependency-injection;dotnet;extensions</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
