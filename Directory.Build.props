<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <Version>1.0.0</Version>
    
    <Authors>Evo Tech Builder</Authors>
    <Company>Evo Tech Builder</Company>
    <Copyright>Copyright © 2026 Evo Tech Builder</Copyright>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/EvoTechBuilder/Mediator</RepositoryUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>mediator;mediatr;messaging;dotnet;cqrs</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
